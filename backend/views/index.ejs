<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MODULEF API</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'media' }
    </script>
</head>

<body
    class="bg-gray-100 dark:bg-neutral-900 text-gray-800 dark:text-gray-100 flex items-center justify-center min-h-screen relative overflow-hidden">

    <!-- Bubble blur background -->
    <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/30 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 -right-20 w-80 h-80 bg-indigo-500/30 rounded-full blur-3xl"></div>
    <div class="absolute top-40 right-40 w-40 h-40 bg-purple-500/20 rounded-full blur-2xl"></div>

    <!-- Card -->
    <div class="relative bg-white dark:bg-neutral-800 rounded-2xl shadow-xl max-w-md w-full p-8 z-10">
        <h1 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-2 text-center">🚀 MODULEF API</h1>
        <p class="text-gray-600 dark:text-gray-400 text-center mb-6">Your backend is running successfully!</p>

        <div class="bg-gray-100 dark:bg-neutral-700 rounded-xl p-4 text-sm space-y-2">
            <p><span class="font-semibold">🌐 Environment:</span>
                <code id="env" class="bg-gray-200 dark:bg-neutral-600 px-2 py-1 rounded"><%= appEnv %></code>
            </p>
            <p><span class="font-semibold">🔗 Base URL:</span>
                <a id="base-url" href="#"
                    class="text-blue-600 dark:text-blue-400 font-medium hover:underline">http://localhost:3000/api</a>
            </p>
            <p><span class="font-semibold">✅ Status:</span> Online</p>
        </div>
    </div>

    <script>
        // Auto set base URL
        document.getElementById("base-url").href = window.location.origin + "/api";
        document.getElementById("base-url").textContent = window.location.origin + "/api";
    </script>
</body>

</html>