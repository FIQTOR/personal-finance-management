# =============================================================================
# Environment Configuration
# Copy this file to .env (production) or .env.development / .env.test and fill
# in real values. This file is the single source of truth for env variables.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Frontend URL used for CORS and for building links in emails.
FRONTEND_HOST="http://localhost:5173"
# Optional: comma separated list of extra allowed CORS origins.
# CORS_ORIGINS="http://localhost:5173,https://app.example.com"

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME="db_personal_finance"
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"
DB_DIALECT="mysql"                # mysql | mariadb | pg (postgres)

# --- Auth: token secrets ----------------------------------------------------
# Generate strong random secrets, e.g. `openssl rand -hex 64`.
ACCESS_TOKEN_SECRET="your_access_token_secret_here"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"
SESSION_SECRET="your_session_secret_here"

# Token lifetimes (use ms-style strings: 15m, 1h, 1d, 30d)
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="1d"
REFRESH_TOKEN_TTL_REMEMBER="30d"

# --- Cookies ----------------------------------------------------------------
# COOKIE_DOMAIN=".example.com"    # leave empty for localhost
# COOKIE_SECURE=true              # defaults to true in production

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CLIENT_REFRESH_TOKEN="your_google_refresh_token"
GOOGLE_DRIVE_ID_USER="your_google_drive_folder_id"

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME="your_email@example.com"
EMAIL_PASSWORD="your_app_password_here"
EMAIL_FROM='"Your App" <no-reply@example.com>'

# --- Branding ---------------------------------------------------------------
APP_NAME="Personal Finance"

# --- Debugging --------------------------------------------------------------
# Set to true to expose error stack traces in API responses (never in prod).
DEBUG_ERRORS=false
